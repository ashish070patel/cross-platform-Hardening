# Backend HTTP port
PORT=5000

# MongoDB Community Server local database; replace with your Atlas URI if needed
MONGODB_URI=mongodb://127.0.0.1:27017/cross_platform_hardening

# Exact origin of the React/Vite frontend (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Obtain your own key at https://aistudio.google.com/apikey
# Required for Generate AI Analysis; never commit your real key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Change only to a Gemini model supported by your API key
GEMINI_MODEL=gemini-2.5-flash